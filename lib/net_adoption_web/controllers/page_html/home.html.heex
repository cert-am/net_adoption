<div id="result">

    <div class="max-w-screen-lg mx-auto flex justify-end text-2xl font-bold text-[#3a5f7e] my-5">Քո կապը</div>

    <div class="mx-auto max-w-screen-lg flex justify-center items-center gap-40">
        <div class="w-full flex flex-col gap-5">
            <.domain_checker domain="" w="full" />
        </div>
        <div class="w-full flex flex-col gap-5">
            <div class="flex flex-col gap-1">
                <div class="flex justify-between gap-2 flex-wrap">
                    <div class="w-[20%] sm:w-[10%] flex items-center">IPv4</div>
                    <div class="w-full md:w-[80%] flex justify-between gap-1 flex-wrap">
                        <div
                            class="w-full bg-green-100 border-2 border-green-500 rounded-xl p-2 text-green-500 overflow-auto">
                            195.250.72.136
                        </div>
                    </div>
                </div>
                <div class="flex justify-between gap-2 flex-wrap">
                    <div class="w-[20%] sm:w-[10%] flex items-center">IPv6</div>
                    <div class="w-full md:w-[80%] flex justify-between gap-1 flex-wrap">
                        <div
                            class="w-full bg-green-100 border-2 border-green-500 rounded-xl p-2 text-green-500 overflow-auto">
                            2001:470:7A1B:2001:1411:0:0:80
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="w-full flex justify-center items-center">
        <span class="text-[#3a5f7e] font-bold text-4xl mt-40">ՀԱՅԿԱԿԱՆ ԿԱԶՄԱԿԵՐՊՈՒԹՅՈՒՆՆԵՐԻ ՑԱՆԿ</span>
    </div>


    <div class="mx-auto flex flex-wrap justify-between items-center my-20 gap-5">


        <%= for {category, organizations} <- @organizations_by_category do %>
            <div class="lg:w-[30%] w-full mt-1 rounded-2xl p-6 text-center shadow-2xl item">
                <div
                    class="mx-auto flex h-16 w-16 -translate-y-12 transform items-center justify-center rounded-full bg-[#3a5f7e] shadow-lg shadow-[#c3cfd8]">

                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="white"
                        class="h-7 w-7 text-[#3a5f7e]">
                        <path
                            d="M320 96L192 96 144.6 24.9C137.5 14.2 145.1 0 157.9 0L354.1 0c12.8 0 20.4 14.2 13.3 24.9L320 96zM192 128l128 0c3.8 2.5 8.1 5.3 13 8.4C389.7 172.7 512 250.9 512 416c0 53-43 96-96 96L96 512c-53 0-96-43-96-96C0 250.9 122.3 172.7 179 136.4c0 0 0 0 0 0s0 0 0 0c4.8-3.1 9.2-5.9 13-8.4zm84 88c0-11-9-20-20-20s-20 9-20 20l0 14c-7.6 1.7-15.2 4.4-22.2 8.5c-13.9 8.3-25.9 22.8-25.8 43.9c.1 20.3 12 33.1 24.7 40.7c11 6.6 24.7 10.8 35.6 14l1.7 .5c12.6 3.8 21.8 6.8 28 10.7c5.1 3.2 5.8 5.4 5.9 8.2c.1 5-1.8 8-5.9 10.5c-5 3.1-12.9 5-21.4 4.7c-11.1-.4-21.5-3.9-35.1-8.5c-2.3-.8-4.7-1.6-7.2-2.4c-10.5-3.5-21.8 2.2-25.3 12.6s2.2 21.8 12.6 25.3c1.9 .6 4 1.3 6.1 2.1c0 0 0 0 0 0s0 0 0 0c8.3 2.9 17.9 6.2 28.2 8.4l0 14.6c0 11 9 20 20 20s20-9 20-20l0-13.8c8-1.7 16-4.5 23.2-9c14.3-8.9 25.1-24.1 24.8-45c-.3-20.3-11.7-33.4-24.6-41.6c-11.5-7.2-25.9-11.6-37.1-15c0 0 0 0 0 0l-.7-.2c-12.8-3.9-21.9-6.7-28.3-10.5c-5.2-3.1-5.3-4.9-5.3-6.7c0-3.7 1.4-6.5 6.2-9.3c5.4-3.2 13.6-5.1 21.5-5c9.6 .1 20.2 2.2 31.2 5.2c10.7 2.8 21.6-3.5 24.5-14.2s-3.5-21.6-14.2-24.5c-6.5-1.7-13.7-3.4-21.1-4.7l0-13.9z" />
                    </svg>
                </div>
                <h1 class="text-[#3a5f7e] mb-3 text-xl font-bold lg:px-14">
                    <%= category %>
                </h1>
                <div class="flex justify-center items-center flex-col px-1 text-[#3a5f7e] font-medium">
                    <%= for organization <- Enum.take(organizations, 5) do %>
                        <%= for domain <- organization.domains do %>
                            <div class="w-full flex justify-between items-center flex-wrap text-sm sm:text-xl">
                                <a href={"https://#{domain.domain}"} target="_blank"
                                    class="hover:scale-105 transition-all">
                                    <%= domain.domain %>
                                </a>
                                <.rate rating={5} size={20} />
                            </div>
                            <% end %>
                                <% end %>

                                    <%= if length(organizations)> 5 do %>
                                        <button hx-get={"organizations/#{category}"} hx-target="#main" hx-push-url={"organizations/#{category}"}>
                                            տեսնել բոլորը
                                        </button>
                                        <% end %>
                </div>
            </div>
            <% end %>
    </div>

</div>